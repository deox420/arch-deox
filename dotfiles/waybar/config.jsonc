// ~/.config/waybar/config.jsonc — barra superior de kali-deox.
// Módulos extra para hacking:
//   custom/vpn      → IP de tu VPN (tun0/wg0): la que pones en LHOST.
//   custom/objetivo → IP de la máquina que atacas (fíjala con: deox-objetivo 10.10.10.5).
// Clic en ellos = copiar al portapapeles.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left":   ["custom/kali", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["custom/objetivo", "custom/vpn", "network", "cpu", "memory",
                       "temperature", "backlight", "wireplumber", "battery", "tray", "custom/apagar"],

    "custom/kali": {
        "format": "",
        "tooltip-format": "Lanzador de apps (SUPER + D)",
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "", "default": "", "empty": "" },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    "hyprland/window": {
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "locale": "es_ES.UTF-8"
    },

    "custom/objetivo": {
        "exec": "deox-objetivo --barra",
        "return-type": "json",
        "interval": 5,
        "on-click": "deox-objetivo --copiar",
        "on-click-right": "deox-objetivo --borrar"
    },

    "custom/vpn": {
        "exec": "deox-vpn-ip --barra",
        "return-type": "json",
        "interval": 5,
        "on-click": "deox-vpn-ip --copiar"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰖪  sin red",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{essid} · {frequency} GHz",
        "on-click": "nm-connection-editor"
    },

    "cpu":    { "format": "  {usage}%", "interval": 3 },
    "memory": { "format": "  {percentage}%", "interval": 5,
                "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },

    "temperature": {
        "critical-threshold": 85,
        "format": " {temperatureC}°",
        "format-critical": " {temperatureC}°"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    "custom/apagar": {
        "format": "⏻",
        "tooltip-format": "Bloquear / salir / apagar",
        "on-click": "wlogout -b 5 -p layer-shell"
    }
}
