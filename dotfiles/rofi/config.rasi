/* ~/.config/rofi/config.rasi — lanzador (SUPER + D). Colores en colores.rasi (deox-tema). */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "kitty";
    drun-display-format: "{name}";
    display-drun: "  apps";
    display-run: "  cmd";
    display-window: "  ventanas";
    matching: "fuzzy";
    sort: true;
}

@import "colores.rasi"

* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    background-color: @bg-alpha;
}

mainbox { padding: 14px; spacing: 10px; children: [ inputbar, listview, mode-switcher ]; }

inputbar {
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @bg2;
    children: [ prompt, entry ];
    spacing: 10px;
}
prompt { text-color: @accent2; }
entry  { placeholder: "buscar…"; placeholder-color: @fg-dim; }

listview { lines: 8; columns: 1; spacing: 4px; scrollbar: false; }

element { padding: 8px 12px; border-radius: 8px; spacing: 10px; }
element-icon { size: 22px; }
element selected.normal { background-color: @accent; text-color: @bg; }
element-text selected { text-color: inherit; }

mode-switcher { spacing: 8px; }
button { padding: 6px; border-radius: 8px; background-color: @bg2; text-color: @fg-dim; }
button selected { background-color: @accent2; text-color: @bg; }
