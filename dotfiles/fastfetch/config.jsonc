// ~/.config/fastfetch/config.jsonc — resumen del sistema al abrir la terminal.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "kali", "padding": { "top": 1, "left": 2 } },
    "display": { "separator": "  ", "color": { "keys": "blue" } },
    "modules": [
        "title",
        "separator",
        { "type": "os",       "key": " sistema " },
        { "type": "kernel",   "key": " kernel  " },
        { "type": "wm",       "key": " ventanas" },
        { "type": "terminal", "key": " terminal" },
        { "type": "cpu",      "key": " cpu     " },
        { "type": "gpu",      "key": "󰍛 gpu     " },
        { "type": "memory",   "key": " memoria " },
        { "type": "disk",     "key": "󰋊 disco   ", "folders": "/" },
        { "type": "battery",  "key": "󰁹 batería " },
        { "type": "localip",  "key": "󰩟 ip      " },
        "break",
        "colors"
    ]
}
