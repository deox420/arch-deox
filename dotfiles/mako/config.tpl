# ~/.config/mako/config — notificaciones. GENERADO por deox-tema (@@nombre@@).
font=JetBrains Mono 10
anchor=top-right
margin=12
padding=12
width=360
border-size=2
border-radius=12
icons=1
max-icon-size=40
default-timeout=6000
background-color=#@@bg2@@e6
text-color=#@@fg@@
border-color=#@@accent@@
progress-color=over #@@accent2@@

[urgency=low]
border-color=#@@bg3@@

[urgency=critical]
border-color=#@@err@@
default-timeout=0
