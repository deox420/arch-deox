#!/usr/bin/env bash
# deox-captura — capturas de pantalla (para informes/writeups).
#   deox-captura zona       seleccionas un trozo (tecla Imprimir)
#   deox-captura pantalla   pantalla entera (Shift + Imprimir)
# Se guardan en ~/Imágenes/Capturas, se copian al portapapeles y se abren en swappy
# para anotarlas (flechas, texto, tapar datos sensibles).
set -euo pipefail
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Capturas"
mkdir -p "$dir"
f="$dir/captura-$(date +%Y%m%d-%H%M%S).png"
case "${1:-zona}" in
  zona)     geo="$(slurp)" || exit 0; grim -g "$geo" "$f" ;;
  pantalla) grim "$f" ;;
  *) echo "Uso: deox-captura [zona|pantalla]" >&2; exit 1 ;;
esac
wl-copy < "$f"
swappy -f "$f" -o "$f" &
notify-send -a kali-deox -i "$f" "Captura guardada" "$f" || true
