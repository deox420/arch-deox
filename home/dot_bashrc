#
# ~/.bashrc — arch-deox
#

# Si no es una shell interactiva, no hacer nada.
[[ $- != *i* ]] && return

# ---------- PATH ----------
export PATH="$HOME/.local/bin:$PATH"

# ---------- Editor por defecto ----------
# Usa neovim si está; si no, vim.
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim VISUAL=nvim
    alias vi='nvim' vim='nvim'
else
    export EDITOR=vim VISUAL=vim
fi

# ---------- Listados: eza (con iconos) si está, si no ls ----------
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -lah --group-directories-first --icons=auto --git'
    alias la='eza -a  --group-directories-first --icons=auto'
    alias lt='eza --tree --level=2 --icons=auto'
else
    alias ls='ls --color=auto'
    alias ll='ls -lah --color=auto'
    alias la='ls -A --color=auto'
fi
alias grep='grep --color=auto'
alias ip='ip --color=auto'

# ---------- bat: 'cat' con colores + páginas de manual coloreadas ----------
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'        # 'cat' normal pero coloreado
    alias less='bat'                       # paginar con colores
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"   # man en color
fi

# ---------- Atajos del entorno ----------
alias hud='deoxhud'                         # panel sci-fi (estilo eDEX)
alias hyprreload='hyprctl reload'           # recargar Hyprland sin cerrar sesión

# ---------- Prompt: starship ----------
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    PS1='[\u@\h \W]\$ '
fi

# ---------- zoxide: 'z' = cd inteligente (recuerda tus carpetas) ----------
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

# ---------- fzf: Ctrl-R (historial), Ctrl-T (archivos), Alt-C (cd) ----------
[ -f /usr/share/fzf/key-bindings.bash ] && source /usr/share/fzf/key-bindings.bash
[ -f /usr/share/fzf/completion.bash ]   && source /usr/share/fzf/completion.bash
