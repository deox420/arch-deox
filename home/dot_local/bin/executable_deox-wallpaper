#!/usr/bin/env bash
# deox-wallpaper — aplica el fondo evitando la carrera "no target" de hyprpaper 0.8.4.
#
# Por qué: hyprpaper 0.8.4 a veces detecta el monitor ANTES de terminar de precargar la
# imagen, y entonces no pinta el fondo (log: "Monitor eDP-1 has no target"). La precarga
# desde ~/.config/hypr/hyprpaper.conf sí ocurre; lo que falla es la asignación al arrancar.
# Este script arranca el daemon y reintenta la asignación por IPC hasta que la acepta.
#
# Uso:  deox-wallpaper [ruta-imagen]   (por defecto: el fondo de arch-deox)
set -u

WP="${1:-$HOME/.local/share/wallpapers/rat-hacker.jpg}"

# Arranca el daemon si no está vivo (lee hyprpaper.conf → precarga la imagen).
if ! pgrep -x hyprpaper >/dev/null 2>&1; then
  hyprpaper >/dev/null 2>&1 &
fi

# Reintenta aplicar el fondo por IPC (sin espacio tras la coma: hyprpaper es estricto).
# Monitor vacío antes de la coma = TODOS los monitores (también proyector/externo).
# La precarga puede tardar; reintentamos ~12 s y confirmamos que queda activo.
for _ in $(seq 1 30); do
  hyprctl hyprpaper wallpaper ",${WP}" >/dev/null 2>&1
  if hyprctl hyprpaper listactive 2>/dev/null | grep -qF "$WP"; then
    exit 0
  fi
  sleep 0.4
done
exit 0
