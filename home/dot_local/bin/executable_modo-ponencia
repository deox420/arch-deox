#!/usr/bin/env bash
# modo-ponencia — prepara el equipo para dar una charla / compartir pantalla.
# ON : silencia notificaciones (mako DND) + evita que la pantalla se apague o
#      se bloquee (detiene hypridle). Ideal mientras compartes pantalla.
# OFF: restaura notificaciones y el apagado/bloqueo por inactividad.
#
# Uso:  modo-ponencia on | off | toggle | estado
# (sin argumentos = toggle)

set -uo pipefail
ESTADO="${XDG_RUNTIME_DIR:-/tmp}/modo-ponencia.on"

aviso() { command -v notify-send >/dev/null && notify-send -t 3500 "🎤 Modo ponencia" "$1" || true; echo ">> $1"; }

activar() {
  # 1) Notificaciones: no molestar
  makoctl mode -a do-not-disturb >/dev/null 2>&1 || true
  # 2) Evitar apagado/bloqueo de pantalla: parar hypridle
  pkill -x hypridle >/dev/null 2>&1 || true
  touch "$ESTADO"
  aviso "ACTIVADO · notificaciones silenciadas · la pantalla no se apagará"
}

desactivar() {
  # 1) Restaurar notificaciones
  makoctl mode -r do-not-disturb >/dev/null 2>&1 || true
  # 2) Relanzar hypridle (apagado/bloqueo por inactividad) si no está
  if ! pgrep -x hypridle >/dev/null 2>&1; then
    hyprctl dispatch exec hypridle >/dev/null 2>&1 || setsid hypridle >/dev/null 2>&1 &
  fi
  rm -f "$ESTADO"
  aviso "DESACTIVADO · todo vuelve a la normalidad"
}

estado() {
  if [ -f "$ESTADO" ]; then echo "modo-ponencia: ON  (notificaciones silenciadas, pantalla siempre encendida)";
  else echo "modo-ponencia: OFF (normal)"; fi
  echo -n "  mako modo: "; makoctl mode 2>/dev/null | paste -sd',' || echo "?"
  echo -n "  hypridle:  "; pgrep -x hypridle >/dev/null 2>&1 && echo "corriendo (apagado por inactividad activo)" || echo "detenido (pantalla no se apaga)"
}

case "${1:-toggle}" in
  on|activar)   activar ;;
  off|desactivar) desactivar ;;
  estado|status) estado ;;
  toggle|*)
    if [ -f "$ESTADO" ]; then desactivar; else activar; fi ;;
esac
