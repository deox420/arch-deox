#!/usr/bin/env bash
# ============================================================================
#  deoxhud — entorno sci-fi estilo eDEX-UI (en tmux).
#  (Nombre propio: NO se llama 'edex', por respeto al autor de eDEX-UI.)
#
#  LO PRINCIPAL es la TERMINAL DE TRABAJO (abajo, grande, centrada). Arriba,
#  dos "hermanos": el globo+reloj+calendario (izq.) y btop (der.).
#
#    ┌────────────────────┬────────────────────────────┐
#    │ 🌍 globo  +  reloj  │                            │
#    │  fecha + calendario │        btop (stats)        │
#    ├────────────────────┴────────────────────────────┤
#    │   TERMINAL DE TRABAJO (fastfetch) — LO MÁS GRANDE │
#    │                                                  │
#    └──────────────────────────────────────────────────┘
#
#  Uso:  deoxhud      → abre (o reconecta a) el panel; el foco va a la terminal
#        Ctrl-a d     → "detach" (lo deja en segundo plano)
#        Ctrl-a &     → cerrar la sesión del panel (confirma con 'y')
# ============================================================================
set -euo pipefail
SESSION=deoxhud

# Si la sesión ya existe, simplemente reconecta.
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# --- Dependencias mínimas ---
need=(tmux btop fastfetch)
miss=()
for c in "${need[@]}"; do command -v "$c" >/dev/null 2>&1 || miss+=("$c"); done
if ((${#miss[@]})); then
  echo "deoxhud: faltan paquetes necesarios: ${miss[*]}" >&2
  echo "  Instálalos con:  sudo pacman -S ${miss[*]}" >&2
  exit 1
fi

# Globo+reloj+calendario (script propio). Respaldo si faltara python.
if command -v deoxhud-globe >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  globe_cmd='deoxhud-globe'
elif command -v tty-clock >/dev/null 2>&1; then
  globe_cmd='tty-clock -c -x -b -s -C 6 -f "%d/%m/%Y"'
else
  globe_cmd='watch -t -c -n1 -- date "+%H:%M:%S%n%d/%m/%Y"'
fi

# --- Construye el layout (IDs de panel, robusto ante base-index) ---
tmux new-session -d -s "$SESSION" -n hud

# Pane inicial (arriba-izquierda) → globo+reloj+calendario.
p_globe=$(tmux list-panes -t "${SESSION}:hud" -F '#{pane_id}' | head -1)

# Terminal de trabajo abajo (55% de alto, todo el ancho) → protagonista.
# La fila superior se queda en ~45% para que btop tenga >=18 filas (su mínimo).
p_term=$(tmux split-window -v -l 55% -t "$p_globe" -P -F '#{pane_id}')

# Fila superior: btop a la derecha (58% del ancho), globo a la izquierda (42%).
p_btop=$(tmux split-window -h -l 58% -t "$p_globe" -P -F '#{pane_id}')

# btop con config compacta del panel (sin lista de procesos → cabe en poco alto).
btop_cfg="$HOME/.config/deoxhud/btop-panel.conf"
[ -f "$btop_cfg" ] && btop_cmd="btop -c $btop_cfg" || btop_cmd="btop"

tmux send-keys -t "$p_globe" "$globe_cmd" C-m
tmux send-keys -t "$p_btop"  "$btop_cmd" C-m
tmux send-keys -t "$p_term"  "clear; fastfetch; echo; exec \$SHELL" C-m

# Foco en la TERMINAL DE TRABAJO.
tmux select-pane -t "$p_term"
exec tmux attach -t "$SESSION"
