#!/usr/bin/env bash
# ============================================================================
#  deoxhud — DASHBOARD sci-fi estilo eDEX-UI (en tmux).
#  (Nombre propio: NO se llama 'edex', por respeto al autor de eDEX-UI.)
#
#  Es un PANEL DE MONITORIZACIÓN, no una terminal de trabajo: para trabajar usa
#  tu kitty normal (limpia). Aquí todo son widgets, sin prompt de shell.
#
#    ┌────────────────────────────────┬─────────────────┐
#    │  fastfetch (specs)             │  🕒 hora+fecha  │
#    ├────────────────────────────────┼─────────────────┤
#    │                               │   🌍 globo      │
#    │        btop  (STATS, grande)  │                 │
#    │      CPU / RAM / red          ├─────────────────┤
#    │                               │   cava 🎵       │
#    └────────────────────────────────┴─────────────────┘
#
#  Uso:  deoxhud      → abre (o reconecta a) el panel
#        Ctrl-a d     → "detach" (lo deja en segundo plano)
#        Ctrl-a &     → cerrar la sesión del panel (confirma con 'y')
# ============================================================================
set -euo pipefail
SESSION=deoxhud

# Si la sesión ya existe, simplemente reconecta.
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# --- Dependencias mínimas ---
need=(tmux btop fastfetch cava)
miss=()
for c in "${need[@]}"; do command -v "$c" >/dev/null 2>&1 || miss+=("$c"); done
if ((${#miss[@]})); then
  echo "deoxhud: faltan paquetes necesarios: ${miss[*]}" >&2
  echo "  Instálalos con:  sudo pacman -S ${miss[*]}" >&2
  exit 1
fi

# Mantiene un panel "vivo" mostrando su salida, SIN prompt de shell.
keep='exec tail -f /dev/null'

# Reloj compacto en recuadro (-x caja, -c centrado, -b negrita, -s segundos).
if command -v tty-clock >/dev/null 2>&1; then
  clock_cmd='tty-clock -c -x -b -s -C 6 -f "%d/%m/%Y"'
else
  clock_cmd='watch -t -c -n1 -- date "+%H:%M:%S%n%d/%m/%Y"'
fi

# Planeta ASCII propio; si faltara python, cmatrix o cava de respaldo.
if command -v deoxhud-globe >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  globe_cmd='deoxhud-globe'
elif command -v cmatrix >/dev/null 2>&1; then
  globe_cmd='cmatrix -ab -C cyan'
else
  globe_cmd='cava'
fi

# --- Construye el layout (IDs de panel, robusto ante base-index) ---
tmux new-session -d -s "$SESSION" -n hud

# Columna IZQUIERDA (70%): franja fastfetch arriba + btop grande debajo.
p_ff=$(tmux list-panes -t "${SESSION}:hud" -F '#{pane_id}' | head -1)

# Columna DERECHA (30%): reloj + globo + cava.
p_clock=$(tmux split-window -h -l 30% -t "$p_ff" -P -F '#{pane_id}')

# --- Izquierda: fastfetch (franja ~18%) sobre btop (grande) ---
tmux send-keys -t "$p_ff" "clear; fastfetch; $keep" C-m
p_btop=$(tmux split-window -v -l 82% -t "$p_ff" -P -F '#{pane_id}')
tmux send-keys -t "$p_btop" "btop" C-m

# --- Derecha: reloj (arriba), globo (medio), cava (abajo) ---
tmux send-keys -t "$p_clock" "$clock_cmd" C-m
p_globe=$(tmux split-window -v -l 78% -t "$p_clock" -P -F '#{pane_id}')
tmux send-keys -t "$p_globe" "$globe_cmd" C-m
p_cava=$(tmux split-window -v -l 42% -t "$p_globe" -P -F '#{pane_id}')
tmux send-keys -t "$p_cava" "cava" C-m

# Foco en las stats (no hay shell donde teclear).
tmux select-pane -t "$p_btop"
exec tmux attach -t "$SESSION"
