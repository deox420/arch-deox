/* Rofi — lanzador (arch-deox). Tema: Catppuccin Mocha. */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: " Apps";
    display-run:  " Run";
    display-window: " Win";
    drun-display-format: "{name}";
}

* {
    bg:     #1e1e2e;
    bg-alt: #313244;
    fg:     #cdd6f4;
    accent: #cba6f7;
    urgent: #f38ba8;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 600px;
    padding: 12px;
}

inputbar {
    children: [prompt, entry];
    padding: 8px;
    background-color: @bg-alt;
    border-radius: 8px;
    margin: 0 0 8px 0;
}

prompt { text-color: @accent; padding: 0 8px 0 0; }
entry  { placeholder: "Buscar…"; placeholder-color: #6c7086; }

listview {
    lines: 8;
    scrollbar: false;
}

element {
    padding: 8px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon { size: 24px; padding: 0 8px 0 0; }
