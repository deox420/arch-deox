/* config.rasi — rofi (arch-deox) · lanzador de apps
 * Comportamiento general. Los colores van en catppuccin-mocha.rasi.
 * Doc: https://davatorium.github.io/rofi/
 */
configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        " Apps";
    display-run:         " Ejec";
    display-window:      " Vent";
    /* Atajos dentro de rofi: Tab cambia de modo (Apps→Ejec→Vent).
     * OJO: Tab e ISO_Left_Tab están ocupados por defecto por kb-element-next/prev.
     * Hay que liberarlos primero (="") o rofi avisa de conflicto de teclas. */
    kb-element-next:     "";
    kb-element-prev:     "";
    kb-mode-next:        "Tab";
    kb-mode-previous:    "ISO_Left_Tab";
}

@theme "catppuccin-mocha"
