/* catppuccin-mocha.rasi — tema de rofi (arch-deox)
 * Catppuccin Mocha + acento neón cian, a juego con Waybar y los bordes de Hyprland.
 */

* {
    /* --- Paleta Catppuccin Mocha --- */
    base:        #1e1e2e;
    mantle:      #181825;
    crust:       #11111b;
    surface0:    #313244;
    surface1:    #45475a;
    text:        #cdd6f4;
    subtext:     #a6adc8;
    overlay:     #6c7086;
    accent:      #89dceb;   /* cian neón (sky) */
    accent2:     #94e2d5;   /* teal */
    urgent:      #f38ba8;   /* rojo */

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border:           2px;
    border-color:     @accent;
    border-radius:    14px;
    background-color: @base;
}

mainbox {
    padding:  16px;
    spacing:  12px;
    children: [ inputbar, listview, mode-switcher ];
}

/* --- Barra de búsqueda --- */
inputbar {
    spacing:          10px;
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @crust;
    children:         [ prompt, entry ];
}
prompt {
    text-color: @accent;
}
entry {
    placeholder:       "Buscar…";
    placeholder-color: @overlay;
    text-color:        @text;
}

/* --- Lista de resultados --- */
listview {
    columns:      1;
    lines:        8;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 8px;
    text-color:    @subtext;
}
element selected {
    background-color: @accent;
    text-color:       @crust;     /* texto oscuro sobre el cian neón */
}
element-icon {
    size:             1.1em;
    vertical-align:   0.5;
    background-color: transparent;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

/* --- Conmutador de modos (Apps / Ejec / Vent) --- */
mode-switcher {
    spacing: 8px;
}
button {
    padding:          6px 10px;
    border-radius:    8px;
    background-color: @mantle;
    text-color:       @overlay;
}
button selected {
    background-color: @surface0;
    text-color:       @accent;
}
