# config — mako (arch-deox) · notificaciones · Catppuccin Mocha + neón cian
# Doc: man 5 mako   ·   recargar: makoctl reload

# ---------- Posición y tamaño ----------
# (sin "output=": así las notificaciones salen en el monitor con foco,
#  también cuando conectas proyector/pantalla externa)
anchor=top-right
margin=12
padding=14
width=380
height=140
outer-margin=10

# ---------- Tipografía ----------
font=JetBrainsMono Nerd Font 11

# ---------- Colores (Catppuccin Mocha) ----------
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89dceb
progress-color=over #313244

# ---------- Forma ----------
border-size=2
border-radius=12
icons=1
max-icon-size=48

# ---------- Comportamiento ----------
default-timeout=6000
ignore-timeout=0
layer=overlay
max-visible=5

# El título en cian neón y negrita; el cuerpo en texto normal.
format=<b><span color="#89dceb">%s</span></b>\n%b

# ---------- Por urgencia ----------
[urgency=low]
border-color=#6c7086
default-timeout=4000

[urgency=normal]
border-color=#89dceb

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

# ---------- Acciones ----------
[mode=do-not-disturb]
invisible=1
