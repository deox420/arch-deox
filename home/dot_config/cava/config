# ============================================================================
#  cava — arch-deox · visualizador de audio para el panel `deoxhud`
#  Paleta neón Tron (degradado cian → verde). Doc: man cava
# ============================================================================

[general]
framerate = 60
autosens = 1
bars = 0          # 0 = automático según el ancho del panel
bar_width = 2
bar_spacing = 1

[input]
method = pulse    # PipeWire expone API de PulseAudio
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[smoothing]
noise_reduction = 0.77

# ---------- Degradado neón (de abajo a arriba) ----------
[color]
background = '#060a0c'
gradient = 1
gradient_count = 6
gradient_color_1 = '#00b3ff'   # azul eléctrico
gradient_color_2 = '#2de2e6'   # cian
gradient_color_3 = '#39ffd0'   # turquesa
gradient_color_4 = '#39ff14'   # verde neón
gradient_color_5 = '#aaff66'   # lima
gradient_color_6 = '#ffd166'   # ámbar (picos)
