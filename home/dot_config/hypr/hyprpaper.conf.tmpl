# hyprpaper.conf — fondo de pantalla (arch-deox)
# Plantilla chezmoi: {{ "{{ .chezmoi.homeDir }}" }} se sustituye por la ruta real
# del HOME al aplicar. IMPORTANTE: hyprpaper NO expande "~", necesita ruta absoluta.
# Doc: https://wiki.hypr.land/Hypr-Ecosystem/hyprpaper/
#
# Las imágenes viven en ~/.local/share/wallpapers (ruta SIN acentos y neutra de idioma:
# hyprpaper falla al parsear rutas con tildes como "Imágenes"). Fuera de chezmoi (binarios).
# Para cambiar de fondo: copia otra ahí y cambia las dos rutas de abajo.

preload = {{ .chezmoi.homeDir }}/.local/share/wallpapers/rat-hacker.jpg
wallpaper = eDP-1,{{ .chezmoi.homeDir }}/.local/share/wallpapers/rat-hacker.jpg

splash = false
ipc = on
