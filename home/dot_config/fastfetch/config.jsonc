// ============================================================================
//  fastfetch — arch-deox · cabecera de specs para el panel `deoxhud`
//  Doc: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
//  Colores en clave ANSI (los pinta la paleta neón de kitty).
// ============================================================================
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",        // logo de Arch compacto (deja sitio a los datos)
    "color": { "1": "cyan" },
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": " ",
    "color": { "keys": "cyan", "title": "green" }
  },

  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os",        "key": " OS",      "keyColor": "cyan" },
    { "type": "kernel",    "key": " Kernel",  "keyColor": "cyan" },
    { "type": "uptime",    "key": "󰅐 Uptime",  "keyColor": "cyan" },
    { "type": "packages",  "key": "󰏖 Pkgs",    "keyColor": "cyan" },
    { "type": "shell",     "key": " Shell",   "keyColor": "cyan" },
    { "type": "wm",        "key": " WM",      "keyColor": "cyan" },
    { "type": "terminal",  "key": " Term",    "keyColor": "cyan" },
    "break",
    { "type": "cpu",       "key": "󰻠 CPU",     "keyColor": "green" },
    { "type": "gpu",       "key": "󰢮 GPU",     "keyColor": "green" },
    { "type": "memory",    "key": "󰍛 RAM",     "keyColor": "green" },
    { "type": "disk",      "key": "󰋊 Disk",    "keyColor": "green" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
