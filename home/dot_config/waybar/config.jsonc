// config.jsonc — Waybar (arch-deox) · barra sólida superior · Catppuccin Mocha + neón
// Cada módulo lleva ICONO + ETIQUETA para que se vea claro qué es cada cosa.
// Doc: https://github.com/Alexays/Waybar/wiki/Configuration
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["cpu", "memory", "temperature", "backlight", "pulseaudio", "network", "power-profiles-daemon", "battery", "tray", "custom/power"],

    // --- Izquierda ---
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        // Muestra SIEMPRE 5 pestañas (escritorios), aunque estén vacías.
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/window": {
        "format": "  {title}",
        "max-length": 50,
        "separate-outputs": true
    },

    // --- Centro ---
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // --- Derecha (icono + etiqueta de texto) ---
    "cpu": {
        "format": "  CPU {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "format": "  RAM {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f} GB / {total:0.1f} GB"
    },
    "temperature": {
        // Ruta estable del sensor de CPU (coretemp), no depende del nº de hwmon.
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "  TEMP {temperatureC}°C",
        "format-critical": "  TEMP {temperatureC}°C"
    },
    "backlight": {
        "format": "  LUZ {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "  VOL {volume}%",
        "format-muted": "  VOL mute",
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5"
    },
    "network": {
        "format-wifi": "  {essid} {signalStrength}%",
        "format-ethernet": "  CABLE {ipaddr}",
        "format-disconnected": "  SIN RED",
        "tooltip-format": "{ifname} · {gwaddr}",
        "on-click": "kitty -e nmtui"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "  BAT {capacity}%",
        "format-charging": "  BAT {capacity}%",
        "format-plugged": "  BAT {capacity}%",
        "tooltip-format": "{timeTo} ({power}W)"
    },
    "power-profiles-daemon": {
        // Clic izquierdo = alterna entre ahorro / equilibrado / rendimiento.
        "format": "{icon} {profile}",
        "tooltip": true,
        "tooltip-format": "Perfil de energía: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "",
            "power-saver": "",
            "balanced": "",
            "performance": ""
        }
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "custom/power": {
        "format": "  ⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/power-menu.sh"
    }
}
